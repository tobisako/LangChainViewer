---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	plan(plan)
	retrieve(retrieve)
	query(query)
	critique(critique)
	report(report)
	reject(reject)
	__end__([<p>__end__</p>]):::last
	__start__ --> plan;
	critique -.-> report;
	critique -.-> retrieve;
	plan -.-> query;
	plan -.-> reject;
	plan -.-> retrieve;
	query --> critique;
	retrieve -.-> critique;
	retrieve -.-> query;
	reject --> __end__;
	report --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
